---
layout: null
permalink: /search.json
---
[
  {% assign all_entries = "" | split: "" %}
  {% assign all_entries = all_entries | concat: site.characters | concat: site.locations | concat: site.factions | concat: site.items | concat: site.sessions %}
  {% for item in all_entries %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "path": {{ item.path | jsonify }},
    "category": {{ item.category | default: "" | jsonify }},
    "summary": {{ item.summary | default: "" | jsonify }},
    "tags": {{ item.tags | default: "" | jsonify }},
    "content": {{ item.content | strip_html | strip_newlines | truncate: 400 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
